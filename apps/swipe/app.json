{
  "expo": {
    "name": "Getfkd",
    "slug": "getfkd",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "getfkd",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.getfkd.ios",
      "buildNumber": "12",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.declared-age-range": true,
        "com.apple.developer.applesignin": ["Default"]
      },
      "infoPlist": {
        "CFBundleDisplayName": "Getfkd",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Get fk'd asks for photos you pick for your profile. It does not need ongoing access to your full library.",
        "NSLocationWhenInUseUsageDescription": "Get fk'd uses approximate on-device location to show a loose distance band to other adults. Precise location is unused. Other people never see your coordinates. You can choose Not now and still swipe.",
        "NSBluetoothAlwaysUsageDescription": "Get fk'd uses Bluetooth only after you turn Get Fk'd mode on. It senses another adult who also turned the mode on nearby. Cues play only while the app is open. The radio does not carry your name, photos, or profile. Bluetooth is not used for background tracking.",
        "NSBluetoothPeripheralUsageDescription": "Get fk'd uses Bluetooth only after you turn Get Fk'd mode on. It senses another adult who also turned the mode on nearby. Cues play only while the app is open. The radio does not carry your name, photos, or profile. Bluetooth is not used for background tracking.",
        "NSLocationDefaultAccuracyReduced": true,
        "LSApplicationCategoryType": "public.app-category.lifestyle",
        "NSDeclaredAgeRangeUsageDescription": "Get fk'd uses your Apple-declared age range to confirm you are 18 or older. The app fails closed if that range is not shared or is under 18."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCoarseLocation",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeSensitiveInfo",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "app.getfkd.android",
      "adaptiveIcon": {
        "backgroundColor": "#FFF0F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Get fk'd uses approximate on-device location to show a loose distance band to other adults. Precise location is unused. You can choose Not now and still swipe."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Get fk'd asks for photos you pick for your profile. It does not need ongoing access to your full library."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF0F4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://getfkd.sentineldefensetechnologies.co.za",
      "privacyPolicyUrl": "https://getfkd.sentineldefensetechnologies.co.za/legal/privacy",
      "supportUrl": "https://getfkd.sentineldefensetechnologies.co.za/legal/support",
      "router": {},
      "eas": {
        "projectId": "422a8c39-c301-42ed-92fd-5045233465d2"
      }
    },
    "owner": "sentinel-defense-technologies"
  }
}
